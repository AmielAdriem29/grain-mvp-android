<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Runs the real ImmatureBackend API on a local port so the Android
      integration and performance tests have a non-production backend to
      call. Real parts: the API (controllers, validation, calculations, the
      ONNX grain detector) and a PostgreSQL database in a throwaway Docker
      container. Replaced: Supabase token checks (a signing key made fresh
      for each run) and Cloudinary (a local image store, see
      LocalImageStore.cs). Nothing here talks to Render, Netlify, the real
      Supabase or the real Cloudinary.

      Expects the backend repo checked out next to this one:
        GitHub/grain-mvp-android
        GitHub/ImmatureBackend
      Override with: dotnet run -p:BackendRoot=D:/path/to/ImmatureBackend/
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BackendRoot Condition="'$(BackendRoot)' == ''">$(MSBuildThisFileDirectory)../../../ImmatureBackend/</BackendRoot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(BackendRoot)ImmatureBackend.Api/ImmatureBackend.Api.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The detector looks for its model next to the running executable. -->
        <None Include="$(BackendRoot)ImmatureBackend.Api/Models/*.onnx"
              Link="Models/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
